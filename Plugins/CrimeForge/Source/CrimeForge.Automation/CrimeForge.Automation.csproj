<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UAT supplies $(EngineDir) when this automation project is discovered via
    -ScriptDir. The optional sibling props file only provides non-hardcoded
    fallbacks for manual/IDE builds.
  -->
  <Import Project="$(MSBuildProjectFullPath).props"
          Condition="Exists('$(MSBuildProjectFullPath).props')" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>

    <Configurations>Debug;Release;Development</Configurations>

    <RootNamespace>CrimeForge.Automation</RootNamespace>
    <AssemblyName>CrimeForge.Automation</AssemblyName>

    <OutputPath>$(EngineDir)\Binaries\DotNET\AutomationTool\AutomationScripts\CrimeForge</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Target Name="ValidateEngineDir" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(EngineDir)' == ''"
      Text="EngineDir was not supplied. Run this project through the current engine's RunUAT with -ScriptDir, pass -p:EngineDir=..., or set UE_ENGINE_DIR." />
    <Error
      Condition="'$(EngineDir)' != '' and !Exists('$(EngineDir)\Binaries\DotNET\AutomationTool\AutomationTool.dll')"
      Text="EngineDir points to an invalid Unreal Engine directory: '$(EngineDir)'." />
  </Target>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Development'">
    <DefineConstants>TRACE</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AutomationTool">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\AutomationTool.dll</HintPath>
    </Reference>

    <Reference Include="AutomationScripts.Automation">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\AutomationScripts\Scripts\AutomationScripts.Automation.dll</HintPath>
    </Reference>

    <Reference Include="AutomationUtils.Automation">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\AutomationUtils\AutomationUtils.Automation.dll</HintPath>
    </Reference>

    <Reference Include="EpicGames.Core">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\EpicGames.Core.dll</HintPath>
    </Reference>

    <Reference Include="EpicGames.Build">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\EpicGames.Build.dll</HintPath>
    </Reference>

    <Reference Include="UnrealBuildTool">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\UnrealBuildTool.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
