<Project>
  <!--
    CrimeForge's managed backend is built from inside arbitrary Unreal project
    repositories. Keep host-repository Directory.Build.props files from leaking
    MSBuild properties into AssetReader. Projects below this directory may still
    use a nearer Directory.Build.props (CUE4Parse has its own).
  -->
  <PropertyGroup>
    <CrimeForgeManagedBuild>true</CrimeForgeManagedBuild>
  </PropertyGroup>
</Project>
