<Project>
  <!--
    AssetReader specifies its package versions directly. This local file stops
    an enclosing repository's central package management from being inherited.
    CUE4Parse has a nearer Directory.Packages.props and continues to use it.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
