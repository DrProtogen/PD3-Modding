<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>

    <Configurations>Debug;Development;Release</Configurations>

    <RootNamespace>CrimeForge.Automation</RootNamespace>
    <AssemblyName>CrimeForge.Automation</AssemblyName>

    <!-- PackagePlugin.cs remains owned by the CrimeForge plugin. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="$(MSBuildThisFileDirectory)..\..\Plugins\CrimeForge\Source\CrimeForge.Automation\PackagePlugin.cs"
      Link="PackagePlugin.cs" />
  </ItemGroup>

  <ItemGroup>

    <Reference Include="AutomationTool">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\AutomationTool.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="AutomationScripts.Automation">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\AutomationScripts\Scripts\AutomationScripts.Automation.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="AutomationUtils.Automation">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\AutomationUtils\AutomationUtils.Automation.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="EpicGames.Core">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\EpicGames.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="EpicGames.Build">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\EpicGames.Build.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnrealBuildTool">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\UnrealBuildTool.dll</HintPath>
      <Private>false</Private>
    </Reference>

  </ItemGroup>

</Project>